# ============================================
# LLM API 配置
# 复制此文件为 .env 并填入你的真实 API Key
# ============================================

# API 密钥（ModelScope / TokenHub / 百度千帆 等）
MODELSCOPE_API_KEY=your_api_key_here

# LLM 请求地址（OpenAI 兼容接口）
# 腾讯 TokenHub: https://tokenhub.tencentmaas.com/v1
# 百度千帆:     https://qianfan.baidubce.com/v2
# ModelScope:   https://api-inference.modelscope.cn/v1
MODEL_API_URL=https://qianfan.baidubce.com/v2

# LLM 模型名称
# 百度千帆: deepseek-v4-flash-202605
# ModelScope: deepseek-ai/DeepSeek-V3.2
MODEL_NAME=deepseek-v4-flash-202605

# ============================================
# Dify 配置
# ============================================

# Dify API 地址
DIFY_API_BASE=https://api.dify.ai/v1

# Dify 应用 API 密钥
DIFY_API_KEY=your_dify_api_key_here

# ============================================
# 数据库配置
# ============================================

# SQLite 本地学习库
DATABASE_URL=sqlite:///./my_database.db

# ============================================
# Embedding 模型配置
# ============================================

# 默认自动检测设备。只有排查设备问题时才取消下一行注释。
# FORCE_DEVICE=mps
# 本地 Embedding 模型（HuggingFace 模型名）
# 推荐: BAAI/bge-small-zh-v1.5 (95MB, 512维, 本地部署)
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# Embedding 模型批量大小
# 必须是正整数；不配置时会按设备选择默认值。
EMBEDDING_BATCH_SIZE=8
# BGE 短查询使用的检索指令；文档入库不会添加此指令。
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# 修改模型、查询指令或归一化策略后，必须重新建立 Chroma 向量索引。

# ============================================
# 多模态 AI（第 33 - 36 章）
# ============================================

# 图像理解（第 33 章）
# 这里的模型必须明确支持图片输入。
VISION_MODEL_NAME=minimax/你的视觉模型名
# 视觉示例使用独立配置，不根据模型名称猜测供应商。
VISION_API_KEY=your_vision_api_key_here
VISION_API_BASE=https://openrouter.ai/api/v1
VISION_IMAGE_URL=https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/bee.jpg

# OpenRouter 音频与文本模型共用此密钥；真实值只写在 .env，绝不提交。
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 从 OpenRouter 当前模型页确认实际可用模型名、音色和格式。
STT_MODEL=your_stt_model_here
STT_LANGUAGE=zh
STT_MAX_AUDIO_BYTES=20971520
STT_AUDIO_PATH=samples/voice.wav

TEXT_MODEL=your_text_model_here

TTS_MODEL=your_tts_model_here
TTS_VOICE=your_supported_voice_here
TTS_FORMAT=mp3
TTS_SPEED=1
TTS_TEXT=你好，这是一次文字转语音测试。
TTS_OUTPUT_PATH=artifacts/tts-output.mp3

PIPELINE_AUDIO_PATH=samples/voice.wav
PIPELINE_OUTPUT_PATH=artifacts/voice-answer.mp3

# ============================================
# LLM 可观测性（第 41 章，可选）
# ============================================

# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_your_key_here
# LANGSMITH_PROJECT=study-python-dev

# 容器端口（第 43 章；不配置时使用 8000）
# APP_PORT=8000
