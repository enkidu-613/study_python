      "history": [],
      "review_material": {
        "prompt": "`TOOLS` 和 `TOOL_FUNCTIONS` 为什么要分开？",
        "answer": "`TOOLS` 是给模型看的工具说明书列表；`TOOL_FUNCTIONS` 是后端按工具名找到真实 Python 函数的映射。模型只生成 tool call，后端才根据映射执行函数。",
        "legacy_id": "review-20260704-ai-agents-tools-functions"
      }
    },
